# Copia este archivo como .env.local (y configura lo mismo en Vercel).
# Sin estas variables la web funciona con los datos de ejemplo.

# Supabase → Project Settings → API (o "Connect"). La misma del sistema de gestión.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# El mismo valor que REVALIDATE_SECRET del sistema de gestión
REVALIDATE_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
